{
  "name": "rail-cabin-design-platform",
  "version": "0.1.0",
  "description": "轨道交通客室项目、资产、任务与智能设计能力集成平台",
  "private": true,
  "keywords": [
    "轨道交通",
    "客室设计",
    "项目资产",
    "Vue 3",
    "Nitro",
    "PostgreSQL",
    "MinIO"
  ],
  "homepage": "https://github.com/hywchina/vue-vben-admin",
  "bugs": "https://github.com/hywchina/vue-vben-admin/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hywchina/vue-vben-admin.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "bootstrap": "pnpm install",
    "build": "pnpm build:rail",
    "build:analyze": "turbo build:analyze",
    "build:docker": "./scripts/deploy/build-local-docker-image.sh",
    "build:docs": "pnpm run build --filter=@vben/docs",
    "build:rail": "pnpm --filter @vben/vite-config stub && pnpm --filter @rail/platform-api build && pnpm --filter @rail/web build",
    "check": "pnpm run check:circular && pnpm run check:dep && pnpm run check:type && pnpm check:cspell",
    "check:circular": "vsh check-circular",
    "check:dep": "vsh check-dep",
    "check:type": "turbo run typecheck",
    "clean": "node ./scripts/clean.mjs",
    "commit": "czg",
    "comfyui:preflight": "pnpm --filter @rail/platform-api comfyui:preflight",
    "dev": "pnpm dev:rail",
    "dev:docs": "pnpm -F @vben/docs run dev",
    "db:rail:migrate": "pnpm --filter @rail/platform-api db:migrate",
    "db:rail:reset-users": "pnpm --filter @rail/platform-api db:reset-users",
    "db:rail:seed": "pnpm --filter @rail/platform-api db:seed",
    "dev:rail": "pnpm --filter @vben/vite-config stub && pnpm infra:rail:up && pnpm db:rail:migrate && pnpm db:rail:seed && pnpm --parallel --stream --filter @rail/platform-api --filter @rail/web dev",
    "dev:rail:web": "pnpm --filter @vben/vite-config stub && pnpm --filter @rail/web dev",
    "format": "vsh lint --format",
    "infra:rail:down": "docker compose -f deploy/rail-platform/compose.yaml down",
    "infra:rail:logs": "docker compose -f deploy/rail-platform/compose.yaml logs -f",
    "infra:rail:up": "docker compose -f deploy/rail-platform/compose.yaml up -d --wait",
    "lint": "vsh lint",
    "postinstall": "pnpm -r run --if-present stub",
    "preinstall": "npx only-allow pnpm",
    "prepare": "is-ci || pnpm exec lefthook install",
    "preview": "turbo-run preview",
    "publint": "vsh publint",
    "reinstall": "pnpm run clean -- --del-lock && pnpm install",
    "test:benchmark": "vitest bench --run",
    "test:unit": "vitest run --dom",
    "test:e2e": "turbo run test:e2e",
    "test:rail": "pnpm --filter @rail/platform-api test && pnpm --filter @rail/web test:unit",
    "test:rail:integration": "pnpm --filter @rail/platform-api test:integration",
    "typecheck:rail": "pnpm --filter @rail/platform-api typecheck && pnpm --filter @rail/web typecheck",
    "update:deps": "npx taze -r -w",
    "catalog": "pnpm dlx codemod pnpm/catalog"
  },
  "dependencies": {
    "sortablejs": "catalog:"
  },
  "devDependencies": {
    "@tsdown/css": "catalog:",
    "@types/node": "catalog:",
    "@vben/commitlint-config": "workspace:*",
    "@vben/eslint-config": "workspace:*",
    "@vben/oxfmt-config": "workspace:*",
    "@vben/oxlint-config": "workspace:*",
    "@vben/stylelint-config": "workspace:*",
    "@vben/tailwind-config": "workspace:*",
    "@vben/tsconfig": "workspace:*",
    "@vben/turbo-run": "workspace:*",
    "@vben/vite-config": "workspace:*",
    "@vben/vsh": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "cross-env": "catalog:",
    "cspell": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "is-ci": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "rimraf": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.12.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.16.0"
}
