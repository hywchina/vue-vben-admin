DATABASE_URL=postgresql://rail_platform:rail_platform_dev@localhost:5432/rail_platform
JWT_SECRET=development-only-change-this-secret-before-production
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
ALLOW_SELF_REGISTRATION=true
APP_PUBLIC_URL=http://localhost:5666
# 开发留空：允许本机回环地址及网卡 IPv4，协议/端口跟随 APP_PUBLIC_URL。
# 显式设置后仅允许列出的完整来源；生产必须显式配置，多个来源用逗号分隔。
CORS_ALLOWED_ORIGINS=
PASSWORD_RESET_TTL_MINUTES=30
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=RailAdmin123!
BOOTSTRAP_ADMIN_NAME=平台管理员
BOOTSTRAP_ADMIN_EMAIL=admin@rail.local
BOOTSTRAP_USER1_USERNAME=user1
BOOTSTRAP_USER1_PASSWORD=RailUser1!2026
BOOTSTRAP_USER1_NAME=普通用户一
BOOTSTRAP_USER1_EMAIL=user1@rail.local
BOOTSTRAP_USER2_USERNAME=user2
BOOTSTRAP_USER2_PASSWORD=RailUser2!2026
BOOTSTRAP_USER2_NAME=普通用户二
BOOTSTRAP_USER2_EMAIL=user2@rail.local
BOOTSTRAP_DEMO_USERS=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@rail.local
SMTP_FROM_NAME=轨道客室智能设计平台
SMTP_TLS_REJECT_UNAUTHORIZED=true
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=railminio
S3_SECRET_KEY=railminio-dev-secret
S3_BUCKET=rail-platform-assets
S3_CORS_ORIGINS=http://localhost:5666
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=900
MAX_UPLOAD_BYTES=2147483648
MAX_INLINE_TEXT_BYTES=5242880
# 本机 vLLM 示例：http://127.0.0.1:18081/v1/chat/completions
# API Key 必须与 vLLM 的 --api-key 一致，只填写在本机或部署环境。
AI_ASSISTANT_API_URL=
AI_ASSISTANT_API_KEY=
AI_ASSISTANT_MODEL=qwen3-vl-8b-instruct
AI_ASSISTANT_TIMEOUT_MS=60000
AI_ASSISTANT_MAX_ATTACHMENT_BYTES=52428800
AI_ASSISTANT_MAX_IMAGES_PER_MESSAGE=4
AI_ASSISTANT_MAX_IMAGE_BYTES_PER_REQUEST=20971520
COMFYUI_API_URL=
COMFYUI_API_TOKEN=
# 本地 HTTPS ComfyUI 使用自签 CA 时填写 CA 证书绝对路径；不要关闭 TLS 校验。
NODE_EXTRA_CA_CERTS=
COMFYUI_API_TIMEOUT_MS=30000
COMFYUI_POLL_INTERVAL_MS=1500
COMFYUI_WORKER_LEASE_SECONDS=90
COMFYUI_MAX_OUTPUT_BYTES=104857600
LORA_API_URL=
LORA_API_TOKEN=
LORA_API_TIMEOUT_MS=120000
LORA_POLL_INTERVAL_MS=5000
LORA_WORKER_LEASE_SECONDS=180
LORA_GPU_IDS=0
LORA_DATASETS_ROOT=/opt/ai-toolkit/data/ai-toolkit-lora-datasets
LORA_MODEL_PATH=/data_hdd/data/models/Flux2Klein/unet/flux-2-klein-9b.safetensors
LORA_VAE_PATH=/data_hdd/data/models/flux2-klein-9B/split_files/vae/flux2-vae.safetensors
LORA_MAX_DATASET_BYTES=2147483648
LORA_MAX_OUTPUT_BYTES=1073741824
# AI 报告服务完整生成地址，例如 http://127.0.0.1:5001/api/v1/generate-file。
REPORT_AI_API_URL=
REPORT_AI_TIMEOUT_MS=600000
REPORT_AI_MAX_OUTPUT_BYTES=104857600
REPORT_AI_TEMPLATE=general
