# Copy to config.env and replace all secret placeholders before use.
PLATFORM_PROJECT_NAME=rail-platform-validation
PLATFORM_IMAGE=rail-platform:1.0.0
PLATFORM_BIND_IP=127.0.0.1
PLATFORM_PORT=18080
PLATFORM_CPUS=4
PLATFORM_MEMORY=6g
PLATFORM_NODE_OPTIONS=--max-old-space-size=2048
# Build settings only; GPU models do not change this CPU-only platform image.
NODE_IMAGE=node:24.16.0-bookworm-slim
NPM_REGISTRY=https://registry.npmmirror.com
BUILD_NODE_OPTIONS=--max-old-space-size=8192
POSTGRES_PORT=15432
S3_PORT=19100
SMTP_HOST_PORT=11025
MAILPIT_WEB_PORT=18025
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
S3_ACCESS_KEY=CHANGE_ME_STORAGE_ACCOUNT
S3_SECRET_KEY=CHANGE_ME_STORAGE_PASSWORD
JWT_SECRET=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_NAME=平台管理员
BOOTSTRAP_ADMIN_EMAIL=admin@rail.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
BOOTSTRAP_DEMO_USERS=false
ALLOW_SELF_REGISTRATION=false
APP_PUBLIC_URL=http://127.0.0.1:18080
CORS_ALLOWED_ORIGINS=http://127.0.0.1:18080,http://127.0.0.1:5666
S3_PUBLIC_ENDPOINT=http://127.0.0.1:19100
S3_BUCKET=rail-platform-validation
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
SMTP_FROM_ADDRESS=noreply@rail.local
SMTP_FROM_NAME=轨道客室智能设计平台
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
AI_ASSISTANT_API_URL=
AI_ASSISTANT_API_KEY=
AI_ASSISTANT_MODEL=qwen3-vl-8b-instruct
COMFYUI_API_URL=
COMFYUI_API_TOKEN=
LORA_API_URL=
LORA_API_TOKEN=
LORA_MODEL_PATH=models/unet/flux-2-klein-9b.safetensors
LORA_VAE_PATH=models/vae/flux2-vae.safetensors
REPORT_AI_API_URL=
