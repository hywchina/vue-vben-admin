# 复制为 .env.production 后替换所有 CHANGE_ME 和示例地址。
# 密码建议只使用字母、数字、横线和下划线，避免 DATABASE_URL 转义问题。

WEB_PORT=8080
S3_PORT=9000
S3_CONSOLE_PORT=9001

APP_PUBLIC_URL=http://192.168.1.100:8080
CORS_ALLOWED_ORIGINS=http://192.168.1.100:8080
S3_PUBLIC_ENDPOINT=http://192.168.1.100:9000

POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
JWT_SECRET=CHANGE_ME_64_CHARACTER_RANDOM_SECRET
S3_ACCESS_KEY=rail_platform_prod
S3_SECRET_KEY=CHANGE_ME_OBJECT_STORAGE_SECRET

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
BOOTSTRAP_ADMIN_NAME=平台管理员
BOOTSTRAP_ADMIN_EMAIL=admin@example.internal
ALLOW_SELF_REGISTRATION=false

# 正式环境填写企业内网邮件系统；不需要认证时将用户和密码留空。
SMTP_HOST=mail.example.internal
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@example.internal
SMTP_FROM_NAME=轨道客室智能设计平台
SMTP_TLS_REJECT_UNAUTHORIZED=true

# GeekAI 填写 https://geekai.co/api/v1/chat/completions 和单独保管的新 API Key。
# 两项留空时聊天仍持久化并明确提示服务未配置。
AI_ASSISTANT_API_URL=
AI_ASSISTANT_API_KEY=
AI_ASSISTANT_MODEL=deepseek-v4-flash-0731
AI_ASSISTANT_TIMEOUT_MS=60000
AI_ASSISTANT_MAX_ATTACHMENT_BYTES=52428800

# ComfyUI 是独立外部服务；留空时平台明确返回 ADAPTER_NOT_CONFIGURED。
# 使用内部 CA 时通过部署环境设置 NODE_EXTRA_CA_CERTS。
COMFYUI_API_URL=
COMFYUI_API_TOKEN=
COMFYUI_API_TIMEOUT_MS=30000
COMFYUI_POLL_INTERVAL_MS=1500
COMFYUI_WORKER_LEASE_SECONDS=90
COMFYUI_MAX_OUTPUT_BYTES=104857600
